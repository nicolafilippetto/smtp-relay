# =============================================================================
# SMTP Relay — Windows configuration
# =============================================================================
# This file is read at service startup and loaded into the process environment.
# The installer copies it to:  C:\ProgramData\smtp-relay\config.env
# and fills in ENCRYPTION_KEY / SECRET_KEY automatically on first install.
#
# Application secrets (Microsoft 365 client id/secret, SMTP account passwords,
# the UI admin credentials) are NOT configured here — you enter them in the
# web panel after the first start.
# =============================================================================

# -----------------------------------------------------------------------------
# Infrastructure secrets — generated by the installer. DO NOT edit by hand and
# NEVER change ENCRYPTION_KEY after data has been stored: every encrypted row
# (e.g. the Microsoft 365 client secret) would become unreadable.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=
SECRET_KEY=

# -----------------------------------------------------------------------------
# Optional knobs — safe defaults; uncomment to override.
# -----------------------------------------------------------------------------

# UI display name (page titles + TOTP issuer).
#APP_NAME=SMTP Relay

# Session lifetime in hours (then re-login is required).
#SESSION_LIFETIME_HOURS=8

# UI login ban policy.
#UI_LOGIN_BAN_THRESHOLD=5
#UI_LOGIN_BAN_DURATION_MIN=30

# SMTP listener. Defaults to all interfaces on 2525. Set the host to
# 127.0.0.1 if only this machine submits mail; keep 0.0.0.0 for LAN clients.
# The listen PORT is chosen in the installer and written below this template by
# the installer (SMTP_LISTEN_PORT=...). To change it afterwards, edit that line
# and restart the relay service (and update the firewall rule for the new port).
#SMTP_LISTEN_HOST=0.0.0.0
#SMTP_LISTEN_PORT=2525

# Maximum inbound message size in bytes (30 MiB default).
#SMTP_MAX_MESSAGE_SIZE=31457280

# Web panel access. By default the panel is reachable from the local network
# (LAN) as well as from this machine: it listens on all interfaces but the app
# rejects any client whose IP is not loopback or private (10.x / 172.16-31.x /
# 192.168.x), so an accidental internet exposure still answers only private
# clients. Set SMTP_UI_ALLOW_LAN=0 to restrict it strictly to this machine.
#SMTP_UI_ALLOW_LAN=1
#SMTP_UI_PORT=8000
# Advanced: force a specific bind address (overrides SMTP_UI_ALLOW_LAN).
#SMTP_UI_HOST=0.0.0.0
# Session/CSRF cookies are marked Secure (HTTPS-only) by default. The Windows
# build serves plain HTTP, so when LAN access is enabled the launcher sets this
# to 0 automatically (browsers won't send Secure cookies over HTTP from a LAN
# address). Leave it unset unless you put the panel behind an HTTPS proxy, in
# which case set it to 1.
#SMTP_UI_COOKIE_SECURE=0

# Storage locations. Default to C:\ProgramData\smtp-relay\data. Override only
# if you want the database and mail archive on a different drive.
#DATABASE_URL=sqlite+aiosqlite:///C:/ProgramData/smtp-relay/data/relay.db
#ARCHIVE_PATH=C:\ProgramData\smtp-relay\data\archive
